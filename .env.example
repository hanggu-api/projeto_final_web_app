# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA commite o arquivo .env no repositório

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_aqui
GOOGLE_WEB_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
MAPBOX_TOKEN=pk.sua_chave_mapbox_aqui
TOMTOM_API_KEY=sua_chave_tomtom_aqui
SIGNUP_VERIFY_TOKEN=seu_token_de_verificacao_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
VAPID_KEY=sua_vapid_key_do_firebase_aqui

# Produção usa Supabase/backend remoto online por padrão.
# Só use true em desenvolvimento local explícito:
# --dart-define=ALLOW_LOCAL_BACKEND=true

# Variáveis usadas apenas em testes (passar via --dart-define)
PROD_API_URL=https://sua-api-de-producao.com/api
